{
  "name": "scrivana",
  "productName": "Scrivana PDF & Word Studio",
  "version": "1.0.0",
  "description": "Profesyonel masaüstü belge stüdyosu: Word seviyesinde kelime işlemci ve Adobe seviyesinde PDF yönetim merkezi.",
  "author": "Scrivana",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"next dev\" \"wait-on tcp:3000 && cross-env NODE_ENV=development electron .\"",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "next build",
    "build:main": "node scripts/patch-tesseract.cjs && tsc -p tsconfig.electron.json && node scripts/copy-assets.cjs",
    "start": "cross-env NODE_ENV=production electron .",
    "dist:win": "npm run build && electron-builder --win && npm run verify",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "verify": "node scripts/verify-release.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.7.1",
    "pdf-lib-with-encrypt": "^1.2.1",
    "pdfjs-dist": "^3.11.174",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tiptap/core": "^2.6.6",
    "@tiptap/extension-character-count": "^2.6.6",
    "@tiptap/extension-color": "^2.6.6",
    "@tiptap/extension-font-family": "^2.6.6",
    "@tiptap/extension-highlight": "^2.6.6",
    "@tiptap/extension-image": "^2.6.6",
    "@tiptap/extension-link": "^2.6.6",
    "@tiptap/extension-placeholder": "^2.6.6",
    "@tiptap/extension-table": "^2.6.6",
    "@tiptap/extension-table-cell": "^2.6.6",
    "@tiptap/extension-table-header": "^2.6.6",
    "@tiptap/extension-table-row": "^2.6.6",
    "@tiptap/extension-text-align": "^2.6.6",
    "@tiptap/extension-text-style": "^2.6.6",
    "@tiptap/extension-underline": "^2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "mammoth": "^1.12.0",
    "marked": "^18.0.9",
    "next": "^14.2.35",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  }
}
