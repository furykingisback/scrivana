{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "lib": ["ES2020"]
  },
  "include": ["main/**/*.ts", "preload/**/*.ts"],
  "exclude": ["node_modules", "out", "src", "renderer", "release"]
}
